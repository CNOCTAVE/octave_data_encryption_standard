#!/bin/sh
# configure for octave_data_encryption_standard
# Generated by hand so that no autotools are required to build the package.
# Usage: ./configure [MKOCTFILE=/path/to/mkoctfile] [ZLIB=-lz]

MKOCTFILE="${MKOCTFILE:-}"
if [ -z "$MKOCTFILE" ]; then
  MKOCTFILE=`command -v mkoctfile 2>/dev/null || true`
fi
if [ -z "$MKOCTFILE" ] && [ -n "$OCTAVE" ]; then
  bindir=`"$OCTAVE" --eval "disp (mkoctfile_path = which ('mkoctfile'))" 2>/dev/null | tail -1`
  MKOCTFILE="$bindir"
fi
if [ -z "$MKOCTFILE" ]; then
  echo "configure: error: mkoctfile not found; set MKOCTFILE=/path/to/mkoctfile" >&2
  exit 1
fi

ZLIB="${ZLIB:--lz}"

case "$MKOCTFILE" in
  *" "*) MKQ="\"$MKOCTFILE\"" ;;
  *) MKQ="$MKOCTFILE" ;;
esac

sed -e "s|@MKOCTFILE@|$MKQ|g" -e "s|@ZLIB@|$ZLIB|g" Makefile.in > Makefile
chmod +x Makefile 2>/dev/null || true
echo "configure: MKOCTFILE=$MKOCTFILE"
echo "configure: ZLIB=$ZLIB"
echo "configure: run 'make' to build des_core.oct"
